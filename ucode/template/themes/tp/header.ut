{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board') ?? {};
	/* bump when theme assets change: busts stale browser caches.
	   Unrelated to PKG_VERSION in the Makefile - keep the two in sync by
	   convention when cutting a release */
	const theme_ver = '20261019.1';

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
	<head>
		<meta charset="utf-8">
		<title>{{ entityencode(striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`), true) }}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="darkreader-lock">
		<link rel="stylesheet" href="{{ media }}/cascade.css?v={{ theme_ver }}">
		<link rel="icon" type="image/png" sizes="128x128" href="{{ media }}/imgs/favicon.png?v={{ theme_ver }}">
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>

	<body class="lang_{{ dispatcher.lang }} {{ entityencode(striptags(node?.title ?? ''), true) }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
		{% if (!blank_page): %}
		<header>
			<div class="header-top">
				<div class="header-logo">
					<a id="tp-brand" href="{{ dispatcher.build_url() }}">
						<span class="tp-brand-hostname">{{ entityencode(boardinfo.hostname ?? '?', true) }}</span>
						<img class="tp-brand-logo" data-src="{{ media }}/imgs/logo.svg?v={{ theme_ver }}" alt="">
					</a>
				</div>
				<div class="header-banner" aria-hidden="true"></div>
			</div>
			<script>
				(function() {
					var brand = document.getElementById('tp-brand');
					var logo = brand ? brand.querySelector('.tp-brand-logo') : null;
					var key = 'luci-theme-tp-brand-logo';

					if (!brand)
						return;

					function applyLogoMode(on) {
						brand.classList.toggle('logo-mode', on);
						document.body.classList.toggle('tp-logo-mode', on);

						/* the logo is display:none by default - only fetch it when needed */
						if (on && logo && !logo.src)
							logo.src = logo.getAttribute('data-src');
					}

					function storageGet(k) {
						try {
							return window.localStorage ? localStorage.getItem(k) : null;
						} catch (e) {
							return null;
						}
					}

					function storageSet(k, v) {
						try {
							if (!window.localStorage)
								return;
							if (v === null)
								localStorage.removeItem(k);
							else
								localStorage.setItem(k, v);
						} catch (e) {}
					}

					applyLogoMode(storageGet(key) === '1');

					brand.addEventListener('click', function(ev) {
						/* modified clicks keep their normal link behaviour
						   (open in new tab/window) instead of toggling */
						if (ev.ctrlKey || ev.metaKey || ev.shiftKey || ev.altKey || ev.button)
							return;

						ev.preventDefault();

						var on = !brand.classList.contains('logo-mode');
						applyLogoMode(on);
						storageSet(key, on ? '1' : null);
					});
				})();
			</script>
			<nav class="header-nav" aria-label="{{ _('Main navigation') }}">
				<ul class="nav" id="topmenu" style="display:none"></ul>
				<div id="indicators" class="header-indicators">
					<div class="indicator-item" id="temp-indicator" style="display:none">
						<i>{{ _('CPU:') }}</i> <span id="temp-value" class="indicator-temp">--</span>°C
					</div>
				</div>
			</nav>
			<script>
				/* temperature polling lives in temp-tp.js so the browser can cache it;
				   the logo-mode script above stays inline to avoid FOUC.
				   If the module cannot be loaded the indicator simply stays hidden. */
				try {
					Promise.resolve(L.require('temp-tp')).catch(function() {});
				} catch (e) {}
			</script>
		</header>

		<div class="page-wrapper">
			<aside class="sidebar" id="sidebar" role="navigation" aria-label="{{ _('Sidebar navigation') }}">
				<ul id="sidemenu" style="display:none"></ul>
				<div class="sidebar-footer">
					<a href="https://github.com/bingoguo93/luci-theme-tp">{{ _('本主题项目主页，') }}<br>{{ _('欢迎 Star & 改进 >>...') }}</a>
				</div>
			</aside>

			<div id="maincontent">
				<div class="content-margin">
					<div class="tp-section-box">
				{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
					<div class="alert-message warning">
						<h4>{{ _('No password set!') }}</h4>
						<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
						{% if (dispatcher.lookup("admin/system/admin")): %}
						  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
						{% endif %}
					</div>
				{% endif %}

				{% if (boardinfo.rootfs_type == "initramfs"): %}
					<div class="alert-message warning">
						<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
						<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
						{% if (dispatcher.lookup("admin/system/flash")): %}
						  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
						{% endif %}
					</div>
				{% endif %}

				<noscript>
					<div class="alert-message warning">
						<h4>{{ _('JavaScript required!') }}</h4>
						<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
					</div>
				</noscript>

				<div id="tabmenu" style="display:none"></div>
		{% else %}
			<div id="maincontent">
		{% endif %}
